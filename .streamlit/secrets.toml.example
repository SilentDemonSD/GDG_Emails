# GDG Email Dashboard - Secrets Configuration
#
# Copy this file to .streamlit/secrets.toml and fill in your credentials.
# The secrets.toml file is gitignored and will NOT be committed.
#
# For Streamlit Community Cloud:
#   Go to app Settings → Secrets and paste these contents.
#
# Add as many [accounts.<key>] sections as needed.
# Each account appears as a selectable option in the dashboard.
# A "Custom" option is always available for manual entry.

[accounts.gdg_miet]
label = "GDG On Campus MIET"
sender_email = "your-gdg-email@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"

[accounts.personal]
label = "Personal Account"
sender_email = "your-personal-email@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"
